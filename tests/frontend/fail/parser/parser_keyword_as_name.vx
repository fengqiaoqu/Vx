// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A reserved word used as a let, for, or fn name should say that word is a
// keyword and point at that token (not at the next one).
//
fn main() -> i32 {
  // CHECK: Error at [[@LINE+1]]:11: `across` is a keyword and cannot be used as a name
  let mut across = 3;
  return 0;
}

fn loop_over_keyword() -> i32 {
  for across in 0..3 {
  }
  return 0;
}

fn across() -> i32 {
  return 0;
}
