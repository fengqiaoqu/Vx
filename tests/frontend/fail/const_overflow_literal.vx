//===----------------------------------------------------------------------===//
// A const whose initializer is a literal that does not fit its type is reported
// once at the declaration.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: Error[E3044] at [[@LINE+1]]:1: const 'D' has a value that does not fit its declared type
const D : u8 = 300;

fn main() -> i32 {
  println!(D);
  println!(D);
  return 0;
}
